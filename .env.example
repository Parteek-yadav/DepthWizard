# DepthWizard Environment Variables

# OpenRouter Free Router API Key (Optional - application runs authoritative deterministic reconstruction if omitted)
# Model used: openrouter/free
OPENROUTER_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Hardware Acceleration (auto, cuda, cpu)
DEVICE=auto

# Mesh & Processing Defaults
DEFAULT_MESH_RESOLUTION=128
MAX_UPLOAD_SIZE_MB=100
